# ---------------------------------------------------------------------------
# SeShaKart environment template. Copy to `.env` for local development.
# NEVER commit real values. Production secrets live in the hosting platform's
# secret manager. Full reference: docs/ENVIRONMENT.md
# ---------------------------------------------------------------------------

# ---- Shared ---------------------------------------------------------------
NODE_ENV=development

# ---- Web (apps/web) -------------------------------------------------------
# Public canonical URL of the storefront (used for metadata, sitemap, canonical links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side address the web app uses to reach the API (never sent to browsers).
API_INTERNAL_URL=http://localhost:4000
# Production canonical host; the apex domain redirects here.
CANONICAL_HOST=www.seshakart.com
# Serve the internal /design-system page in production builds (staging only).
ENABLE_DESIGN_SYSTEM_PAGE=false

# ---- API (apps/api) -------------------------------------------------------
API_PORT=4000
# Storefront origin — used for CORS and for links in emails.
APP_URL=http://localhost:3000
# Extra comma-separated CORS origins (optional).
CORS_ORIGINS=
# Proxies in front of the API that set X-Forwarded-For. Production behind
# infra/nginx (which overwrites it with the client IP): 1. Local: 0.
TRUST_PROXY_HOPS=0
LOG_LEVEL=log

# ---- Database & cache ----------------------------------------------------
DATABASE_URL=postgresql://seshakart:seshakart@localhost:5432/seshakart?schema=public
# Log queries slower than this (ms).
DB_SLOW_QUERY_MS=250
# Required in production. Optional locally (falls back to in-memory stores).
REDIS_URL=redis://localhost:6379
# Global per-IP rate limit.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
# Tests only; production refuses to start with false.
RATE_LIMIT_ENABLED=true

# ---- Seed (first super admin; see docs/DATABASE.md) -----------------------
SEED_ADMIN_EMAIL=
# Min 8 chars with a letter and a number. Use a long random value in production.
SEED_ADMIN_PASSWORD=

# ---- Tests (optional overrides) -------------------------------------------
# TEST_DATABASE_URL=postgresql://seshakart:seshakart@localhost:5432/seshakart_test?schema=public
# TEST_REDIS_URL=redis://localhost:6379/15
# SHADOW_DATABASE_URL=postgresql://seshakart:seshakart@localhost:5432/seshakart_shadow

# ---- Authentication (see docs/SECURITY.md) -------------------------------
# ≥ 32 random characters each, and different from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Optional parent cookie domain; leave empty for host-only cookies (recommended).
COOKIE_DOMAIN=

# ---- Email & SMS -----------------------------------------------------------
# Without SMTP_HOST, emails are printed to the API log (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SeShaKart <no-reply@seshakart.com>"
# console = print codes to the API log (development); none = disable mobile codes.
SMS_PROVIDER=console

# ---- Media ------------------------------------------------------------------
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=uploads
MEDIA_PUBLIC_BASE=/api/media

# ---- Payments ---------------------------------------------------------------
# mock = simulated payments for development and tests (refused in production).
# razorpay = live/test Razorpay: all three credentials are then required. The key
# secret and webhook secret never leave the API; only the key id reaches browsers.
PAYMENT_PROVIDER=mock
# PAYMENT_KEY_ID=rzp_test_xxxxxxxxxxxx
# PAYMENT_KEY_SECRET=
# PAYMENT_WEBHOOK_SECRET=

# ---- Added in later phases (documented now so deployments can plan) ------
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# MEDIA_BASE_URL=
# NEXT_PUBLIC_ANALYTICS_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
