{
  "name": "seshakart",
  "private": true,
  "version": "1.0.0",
  "description": "SeShaKart Pvt. Ltd. — production e-commerce platform (web + API monorepo)",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm --filter @seshakart/api build && pnpm --filter @seshakart/web build",
    "build:packages": "pnpm -r --filter ./packages/** build",
    "dev": "pnpm build:packages && pnpm -r --parallel --filter @seshakart/api --filter @seshakart/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @seshakart/e2e test",
    "db:migrate": "pnpm --filter @seshakart/api prisma:migrate",
    "db:deploy": "pnpm --filter @seshakart/api prisma:deploy",
    "db:seed": "pnpm --filter @seshakart/api seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "~5.6.3"
  }
}
