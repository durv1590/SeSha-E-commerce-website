{
  "name": "seshakart",
  "private": true,
  "version": "0.1.0",
  "description": "SeShaKart Pvt. Ltd. — production e-commerce platform (web + API monorepo)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "build": "pnpm build:packages && pnpm --filter @seshakart/api build && pnpm --filter @seshakart/web build",
    "dev": "pnpm build:packages && pnpm --parallel --filter @seshakart/api --filter @seshakart/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "~5.8.3"
  }
}
