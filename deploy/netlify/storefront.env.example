# SeShaKart storefront on Netlify: environment variables
#
# Netlify → Site configuration → Environment variables → Add a variable →
# "Import from a .env file", then paste this file after replacing every <…>.
# After any change here, redeploy with "Clear cache and deploy site": the /api
# connection to the API is fixed when the site is built.
#
# The storefront needs the API running somewhere else first (see
# docs/DEPLOYMENT.md, "Netlify storefront + API on Render").

# Node.js version for the Netlify build (the repository needs 22.9 or newer).
NODE_VERSION=22

# Public address of the SeShaKart API, without a trailing slash, e.g.
# https://seshakart-api.onrender.com. Server-side only; browsers never see it.
API_INTERNAL_URL=<https://your-api-host>

# This site's own public address (canonical links, sitemap, emails).
NEXT_PUBLIC_SITE_URL=https://seshakart.netlify.app

# Must be exactly the same value as REVALIDATE_SECRET on the API. It lets admin
# changes (products, prices, banners) show on the store immediately.
REVALIDATE_SECRET=<copy REVALIDATE_SECRET from the API>

# Keep search engines out of this test address. Only https://www.seshakart.com is
# ever indexable, so this is a second safety net.
ALLOW_INDEXING=false

NEXT_TELEMETRY_DISABLED=1

# Optional: analytics (load only after the visitor accepts cookies).
# NEXT_PUBLIC_ANALYTICS_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# Do NOT set CANONICAL_HOST to seshakart.netlify.app: it is meant for the
# www.seshakart.com domain and would make this address redirect to itself.
