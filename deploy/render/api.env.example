# SeShaKart API: environment variables for the Netlify setup
#
# With render.yaml (Render → New → Blueprint) most of these are filled in for you.
# Use this file when you create the API by hand on Render, Railway, Fly.io or a VPS:
# replace every <…> and add the variables in the host's dashboard.
# Every variable is explained in docs/ENVIRONMENT.md.
#
# Generate each secret separately:  openssl rand -base64 32
# Never commit the filled-in copy.

NODE_ENV=production
API_PORT=4000
# Some hosts (Render, Railway) route traffic to $PORT: keep it equal to API_PORT.
PORT=4000

# The Netlify storefront.
APP_URL=https://seshakart.netlify.app
WEB_INTERNAL_URL=https://seshakart.netlify.app

# PostgreSQL 16 and Redis 7 connection strings from your host.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
REDIS_URL=redis://<host>:6379

# Secrets: at least 32 characters, all different.
JWT_SECRET=<openssl rand -base64 32>
SESSION_SECRET=<openssl rand -base64 32>
# Put the same value in Netlify's REVALIDATE_SECRET.
REVALIDATE_SECRET=<openssl rand -base64 32>

# The host's proxy in front of the API. Behind Netlify all shoppers share Netlify's
# addresses, so the global limit is raised for a test site.
TRUST_PROXY_HOPS=1
RATE_LIMIT_MAX=3000

# Uploaded product images: mount a persistent disk here.
MEDIA_LOCAL_DIR=/app/uploads

# Email (required in production).
SMTP_HOST=<smtp.your-provider.com>
SMTP_PORT=587
SMTP_USER=<smtp user>
SMTP_PASSWORD=<smtp password>
MAIL_FROM=SeShaKart <no-reply@seshakart.com>

# Mobile sign-in codes off until an SMS gateway is added.
SMS_PROVIDER=none

# Razorpay: test keys (rzp_test_…) for a test site, live keys for real orders.
# Webhook URL in Razorpay (straight to the API, not through Netlify):
#   https://<your-api-host>/api/webhooks/payments/razorpay
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=<rzp_test_…>
PAYMENT_KEY_SECRET=<razorpay key secret>
PAYMENT_WEBHOOK_SECRET=<secret you set on the Razorpay webhook>

# First super admin, created on the first start (npm run start:release).
# Delete SEED_ADMIN_PASSWORD once you have signed in and changed the password.
SEED_ADMIN_EMAIL=<you@example.com>
SEED_ADMIN_PASSWORD=<long random password with a letter and a number>

# Start command for hosts that don't use the Dockerfile's default:
#   npm run start:release   (migrations → settings/admin seed → API)
