# ---------------------------------------------------------------------------
# SeShaKart production environment (docker compose). Copy to `.env.production` on the
# server, fill in every "<...>", keep it readable only by the deploy user (chmod 600).
# NEVER commit the filled-in file. Reference: docs/ENVIRONMENT.md, docs/DEPLOYMENT.md.
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
NODE_ENV=production

# ---- Database (the compose postgres service) --------------------------------
POSTGRES_USER=seshakart
POSTGRES_DB=seshakart
POSTGRES_PASSWORD=<long random secret>
# DATABASE_URL and REDIS_URL are set by infra/docker-compose.yml from the values above.
# Using a managed database instead? Set DATABASE_URL here and remove the postgres service.

# ---- Traffic (docs/DEPLOYMENT.md, "How traffic reaches the server") ---------
# Cloudflare Tunnel token (compose profile "tunnel", recommended).
CLOUDFLARE_TUNNEL_TOKEN=<tunnel token from Cloudflare Zero Trust>
# Only without the tunnel: expose nginx on port 80 to Cloudflare's IP ranges.
# EDGE_BIND=0.0.0.0

# ---- Public site (also needed when BUILDING the web image) -----------------
NEXT_PUBLIC_SITE_URL=https://www.seshakart.com
CANONICAL_HOST=www.seshakart.com
# Keep search engines out until launch day, then delete this line.
ALLOW_INDEXING=false
# Optional analytics (loaded only after cookie consent; see docs/SEO_ANALYTICS.md).
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---- API --------------------------------------------------------------------
APP_URL=https://www.seshakart.com
LOG_LEVEL=log
JWT_SECRET=<long random secret>
SESSION_SECRET=<a different long random secret>
# Same value in the API and the web app (both read this file).
REVALIDATE_SECRET=<long random secret>

# ---- Email (required in production) -------------------------------------------
# Any SMTP provider (Amazon SES, SendGrid, Zoho, …). Authorise the sender with SPF, DKIM
# and DMARC at your DNS provider, or emails will land in spam.
SMTP_HOST=<smtp host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp user>
SMTP_PASSWORD=<smtp password>
MAIL_FROM="SeShaKart <no-reply@seshakart.com>"
# No DLT-registered SMS gateway yet: mobile one-time codes are off; customers sign in
# with email + password or an email code.
SMS_PROVIDER=none

# ---- Payments (Razorpay live keys; required) ------------------------------------
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=rzp_live_<...>
PAYMENT_KEY_SECRET=<razorpay key secret>
# The secret you set on the webhook https://www.seshakart.com/api/webhooks/payments/razorpay
PAYMENT_WEBHOOK_SECRET=<razorpay webhook secret>

# ---- First super admin (used once by the seed; remove afterwards) ---------------
SEED_ADMIN_EMAIL=<owner email>
SEED_ADMIN_PASSWORD=<long random password; change it after the first sign-in>
